# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Render, Vercel Postgres, local…).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos"

# ── Optional ────────────────────────────────────────────────────────────────
# Public origin of the deployment. Used for password-reset links and Origin checks.
# Leave empty to derive it from the incoming request.
APP_URL=""
# Password-reset e-mail delivery through Resend (https://resend.com). Without it,
# password reset still works through the one-time recovery code shown at sign-up.
RESEND_API_KEY=""
EMAIL_FROM="LIFEOS <no-reply@example.com>"
# Set to "1" to disable new registrations on a private deployment.
DISABLE_REGISTRATION=""
